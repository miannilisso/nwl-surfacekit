{
  "name": "nwl-surfacekit",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:packages": "pnpm --filter @nwl/surfacekit build",
    "dev": "turbo dev",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "vitest --run",
    "test:a11y": "playwright test --project=chromium tests/e2e/a11y.spec.ts",
    "test:browser": "playwright test tests/e2e/smoke.spec.ts",
    "test:components": "vitest --run packages/ui/src",
    "test:components:coverage": "vitest --run packages/ui/src --coverage",
    "test:contracts": "vitest --run tests/contracts",
    "test:env": "node tests/env/no-server-env-in-client.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "pnpm --filter web build && playwright test --config playwright.production.config.ts",
    "test:storybook": "vitest --config vitest.storybook.config.ts --run",
    "test:visual": "playwright test --project=chromium tests/e2e/visual.spec.ts",
    "test:watch": "vitest",
    "verify": "CI=1 TERM=dumb sh -c 'pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:contracts && pnpm test:components:coverage && pnpm build && pnpm build-storybook && pnpm test:storybook && pnpm test:env && pnpm playwright test --config playwright.production.config.ts'",
    "verify:ci": "CI=1 TERM=dumb sh -c 'pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:contracts && pnpm test:components:coverage && pnpm build && pnpm build-storybook && pnpm test:storybook && pnpm test:env && pnpm playwright test --config playwright.production.config.ts'",
    "storybook": "storybook dev -p 6006 --config-dir apps/web/.storybook --initial-path /?path=/story/surfacekit-introduction--overview",
    "build-storybook": "storybook build --config-dir apps/web/.storybook"
  },
  "devDependencies": {
    "@nwl/eslint-config": "workspace:*",
    "@nwl/typescript-config": "workspace:*",
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "storybook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
